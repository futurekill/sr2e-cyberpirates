    {
      "_id": "d24a6ade352a7383",
      "name": "SS-N-49 \"Sirocco\" Antiship Missile",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>A Russian antiship missile sold worldwide; the design is over fifteen years old but keeps up its Soviet ancestors' fearsome reputation.</p><table><tr><th>Handling</th><td>4</td></tr><tr><th>Speed</th><td>800</td></tr><tr><th>Range</th><td>350 km</td></tr><tr><th>Body</th><td>3</td></tr><tr><th>Signature</th><td>5</td></tr><tr><th>Intelligence</th><td>3</td></tr><tr><th>Damage</th><td>20SN</td></tr><tr><th>Weight</th><td>750 kg</td></tr><tr><th>Cost</th><td>600,000¥</td></tr></table><p><em>Cyberpirates p.179.</em></p>"
      },
      "sort": 200000,
      "ownership": {
        "default": -1
      },
